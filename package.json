{
  "name": "research-loop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "research-loop": "dist/cli.js"
  },
  "files": [
    "dist/",
    "runtime/README.md",
    "runtime/observations.json",
    "runtime/retirement-observations.json",
    "benchmarks/cpu_regression/",
    "benchmarks/cactus/",
    "integrations/protok/README.md",
    "integrations/protok/assets/",
    ".github/PULL_REQUEST_TEMPLATE.md",
    "docs/",
    "references/",
    "SKILL.md",
    "CONTRIBUTING.md",
    "AGENTS.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p runtime/tsconfig.build.json",
    "check": "tsc --noEmit -p runtime/tsconfig.json",
    "test": "node --experimental-strip-types --test runtime/tests/*.test.ts",
    "start": "node dist/cli.js",
    "pack": "node tools/package.mjs"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@earendil-works/pi-env": "1.5.0",
    "@earendil-works/pi-schema": "1.5.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
