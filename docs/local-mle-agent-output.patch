@@ -0,0 +1,96 @@
+"""CPU fixtures for the optional local-MLE report-only adapter patch."""
+
+import json
+import unittest
+from unittest.mock import patch
+
+from benchmarks.local_mle.bridge import REPORT_SCHEMA
+from research_loop.harness import completed_response, publish_completed_response
+from test_local_mle_bridge import BridgeTests, REQUEST, RequestDelegate
+
+
+class ReportDelegate(RequestDelegate):
+    def run(self, **kwargs):
+        full = super().run(**kwargs)
+        report = {"markdown": full["markdown"]}
+        publish_completed_response(kwargs["run_dir"], report)
+        return report
+
+
+class AgentOutputTests(unittest.TestCase):
+    def fixture(self):
+        fixture = BridgeTests()
+        fixture.setUp()
+        self.addCleanup(fixture.doCleanups)
+        return fixture
+
+    def test_controller_constructs_fields_and_retains_nested_raw_receipt(self):
+        fixture = self.fixture()
+        arguments = fixture.arguments()
+        delegate = ReportDelegate([REQUEST])
+        bridge = fixture.bridge(delegate)
+        result, _ = fixture.run_bridge(bridge, arguments)
+        self.assertEqual(result["outcome"], "completed")
+        self.assertEqual(delegate.kwargs["schema"], REPORT_SCHEMA)
+        measurement = result["measurements"][0]
+        self.assertEqual(measurement["candidate_id"], REQUEST["job_id"])
+        self.assertEqual(measurement["evaluation_id"], "global-development-v1")
+        self.assertEqual(measurement["comparison_scope"], "development-v1")
+        self.assertEqual(measurement["metrics"], [{"name": "auc", "value": 0.75}])
+        self.assertEqual(completed_response(arguments["run_dir"]), result)
+        raw = completed_response(arguments["run_dir"] / "bridge-call")
+        self.assertEqual(set(raw), {"markdown"})
+        # Existing source/effect validator must still reject receipt tampering.
+        public = arguments["workspace"] / "results" / REQUEST["job_id"] / "result.json"
+        receipt = json.loads(public.read_text())
+        receipt["score"] = 0.99
+        public.write_text(json.dumps(receipt))
+        with self.assertRaisesRegex(Exception, "trusted bridge receipt"):
+            bridge.validate_completed(
+                result, workspace=arguments["workspace"], run_dir=arguments["run_dir"]
+            )
+
+    def test_new_call_does_not_republish_previous_jobs(self):
+        fixture = self.fixture()
+        bridge = fixture.bridge(ReportDelegate([REQUEST]))
+        first = fixture.arguments()
+        fixture.run_bridge(bridge, first)
+        bridge.delegate = ReportDelegate([])
+        second = fixture.arguments("second")
+        result, _ = fixture.run_bridge(bridge, second)
+        self.assertEqual(result["outcome"], "incomplete")
+        self.assertEqual(result["artifacts"], [])
+        self.assertEqual(result["measurements"], [])
+        self.assertEqual(len(fixture.calls), 1)
+
+    def test_unreserved_error_and_success_cannot_report_completed(self):
+        fixture = self.fixture()
+        delegate = ReportDelegate([REQUEST])
+        bridge = fixture.bridge(delegate)
+        original = bridge._reserve
+
+        def reserve(*args, **kwargs):
+            bridge.bridge_errors.append("another request failed before reservation")
+            return original(*args, **kwargs)
+
+        with patch.object(bridge, "_reserve", side_effect=reserve):
+            result, _ = fixture.run_bridge(bridge, fixture.arguments())
+        self.assertEqual(result["outcome"], "incomplete")
+        self.assertEqual(len(result["measurements"]), 1)
+
+    def test_unexpected_worker_failure_blocks_parent_publication(self):
+        fixture = self.fixture()
+        delegate = ReportDelegate([])
+        bridge = fixture.bridge(delegate)
+        arguments = fixture.arguments()
+
+        def watch(workspace, stop, ready):
+            ready.set()
+            stop.wait()
+            raise RuntimeError("worker failed outside request handling")
+
+        with patch.object(bridge, "_watch", side_effect=watch):
+            with self.assertRaisesRegex(Exception, "effects require reconciliation"):
+                fixture.run_bridge(bridge, arguments)
+        self.assertIsNone(completed_response(arguments["run_dir"]))
+        self.assertIsNotNone(completed_response(arguments["run_dir"] / "bridge-call"))
